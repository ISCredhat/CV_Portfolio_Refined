# Project-level ignore rules (the repo-root .gitignore also applies; rules here take precedence)

# Local data store: everything under data/ stays out of git except the README and two small
# curated, wallet-free CSVs. (data/manual/known_cases.csv names a wallet from published reporting and
# stays ignored on purpose; pilot_*.csv are regenerated by `pmdetect pilot`.)
data/*
!data/README.md
!data/manual/
data/manual/*
!data/manual/info_type_labels.csv
!data/manual/news_time_overrides.csv
data/private/
data/raw_cache/
data/tapes/
data/snapshots/
data/duckdb_tmp/

# Logs, scratch output of `pmdetect demo run`, environments, caches
logs/
demo_output/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Databases and Parquet anywhere, except the small anonymised demo fixtures
*.duckdb
*.duckdb.wal
*.parquet
!tests/fixtures/demo/
!tests/fixtures/demo/*.parquet
!tests/fixtures/demo/*.csv
!tests/fixtures/demo/*.json

# Temporary files
*.tmp
*.bak

# Large regenerable result tables (16 MB and 6 MB; rebuilt by `pmdetect score-markets` / `pmdetect integrity`).
# Remove these two lines to publish them; the root .gitignore otherwise allows results/*.csv.
results/market_scores.csv
results/integrity_report.csv

# Bulk per-market charts (120 files, regenerated by `pmdetect score-markets`); only the curated figures
# (D_histogram, within_event_placebo, nobel_event_moves, calibration_curve, validation_*_power) are committable.
results/figures/flagged_*.png
results/figures/case_*.png
